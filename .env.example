# Google Cloud Vision API
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Pinata IPFS
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# Polygon Amoy Testnet
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# Deployed contract address on Amoy
CONTRACT_ADDRESS=0x_your_contract_address_here

# ─── MOCK MODE ────────────────────────────────────────────────────────────────
# Set to 'true' ONLY for CI/testing. NEVER enable with real credentials.
# A loud WARNING is printed to stderr when this is enabled.
# ────────────────────────────────────────────────────────────────────────────────
PIPELINE_MOCK_MODE=false

